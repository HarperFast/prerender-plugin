	"config": {
		"changeProbe": {
			"enabled": true,
			"dryRun": false,
			"rules": [
				{
					"label": "pdp-price-availability",
					"pathPattern": "^/product/prd-([^/]+)",
					"source": "request",
					"request": {
						"urlTemplate": "https://www.example.com/api/product/$1",
						"method": "GET",
						"headers": {
							"accept": "application/json"
						}
					},
					"extract": [
						"product.price.regular",
						"product.price.sale",
						"product.price.lowest",
						"product.status",
						"product.priceSet",
						"product.availableOnline",
						"product.url",
						"product.price.saleStatus",
						"product.price.percentOff",
						"product.price.promotion",
						"product.badges",
						"product.isNew",
						"product.bestSeller",
						"product.topRated",
						"product.title",
						"product.brand",
						"product.meta.title",
						"product.meta.description",
						"product.images[0].url",
						"product.breadcrumbs"
					],
					"invalidateScope": "route:prefix:/product/prd-",
					"statusSignals": [
						{
							"status": 400,
							"contains": "ERR_UNAVAILABLE",
							"signature": "unavailable"
						},
						{
							"status": 400,
							"contains": "ERR_UNKNOWN_ID",
							"signature": "unknown-id"
						}
					],
					"pageCheck": {
						"enabled": true,
						"priceFrom": 2,
						"availableFrom": 3
					}
				}
			],
			"mode": "anchored",
			"anchorTime": "00:05",
			"anchorTimezone": "America/Chicago",
			"anchorWindow": 0,
			"sweepInterval": 43200000,
			"cycleTarget": 86400000,
			"ratePerSecond": 10,
			"concurrency": 4,
			"reprobeAfter": 21600000,
			"backoffMax": 64,
			"load.enabled": false,
			"load.lagThreshold": 50,
			"load.backoffMax": 8,
			"load.resolution": 10,
			"abortAfterDistress": 50,
			"chunkSize": 2000,
			"trigger.ratePerSecond": 3,
			"trigger.concurrency": 4,
			"trigger.maxPending": 50000,
			"maxTriggersPerSweep": 150000,
			"requestTimeout": 10000,
			"maxResponseBytes": 5242880,
			"startDelay": 300000,
